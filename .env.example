# ─── Key Verification ───
# Enable/disable API key verification against provider endpoints
ENABLE_VERIFY=true
# Number of concurrent verification workers
VERIFY_WORKERS=20
# Timeout per verification request (seconds)
VERIFY_TIMEOUT=15

# ─── Dashboard ───
# Password to access the web dashboard
DASHBOARD_PASSWORD=0770984mmnnAliYOURSOGAY
# Port for the web server (auto-detected in cloud deployments)
PORT=8080

# ─── API Proxy ───
# Enable the API proxy endpoints (e.g. /api/openai/v1/chat/completions)
PROXY_ENABLED=true

# ─── Auto-Validation ───
# Automatically re-validate stored keys on a schedule
AUTO_VALIDATE=true
# How often to re-validate keys (1h, 6h, 12h, 24h, 72h)
VALIDATE_INTERVAL=24h

# ─── Headless Mode ───
# Set to true to run without TUI (for Docker/cloud deployments)
HEADLESS=true
